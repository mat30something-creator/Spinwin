# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=https://yourdomain.com          # Public URL (for QR code links)
DASHBOARD_URL=https://yourdomain.com     # Used in email footer link
ALLOWED_ORIGIN=https://yourdomain.com    # CORS origin

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./spinwin.db                     # SQLite file path

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail example — use an App Password (not your real password)
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# For SendGrid instead:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# ─── Demo ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=you@spinwinleads.com     # Notified on every new dealer signup
